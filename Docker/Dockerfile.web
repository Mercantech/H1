FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["H1.Web/H1.Web.csproj", "H1.Web/"]
COPY ["H1.ServiceDefaults/H1.ServiceDefaults.csproj", "H1.ServiceDefaults/"]
RUN dotnet restore "H1.Web/H1.Web.csproj"
COPY . .
WORKDIR "/src/H1.Web"
RUN dotnet build "H1.Web.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "H1.Web.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "H1.Web.dll"]
